# Copy to .env. Public-safe values only (Vite inlines them into the bundle).
# Local FastAPI server; set to the deployed backend URL in production.
VITE_API_URL=http://localhost:8000

# Auth step (not yet used): Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
