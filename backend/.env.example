# Copy to .env and fill in. Never commit .env.

# Frontend URLs allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Step 2: Supabase project settings (Project Settings > API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PUBLISHABLE_KEY: I added this row -- public anon key; auth.py uses it to verify tokens when no service key is set.
PUBLISHABLE_KEY=
# DIRECT_CONNECTION_STRING: I added this row -- SQLAlchemy Postgres URL (pooler, :6543) used by database.py.
DIRECT_CONNECTION_STRING=


# Optional: who gets a copy of every order email.
OWNER_NOTIFY_EMAIL=
