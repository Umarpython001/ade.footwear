# Copy to .env and fill in. Never commit .env.

# Frontend URLs allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Step 2: Supabase project settings (Project Settings > API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Step 6: Mailgun.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

# Optional: who gets a copy of every order email.
OWNER_NOTIFY_EMAIL=
